# Production environment for rag-docs.
# Copy to .env on the server, fill in real values, never commit it.

# Public hostname Caddy will request a Let's Encrypt cert for.
DOMAIN=rag.example.com

# Email used by Let's Encrypt for expiry notices.
ACME_EMAIL=you@example.com

# Postgres credentials. Generate strong values:
#   openssl rand -hex 24
POSTGRES_USER=rag
POSTGRES_PASSWORD=replace-me-with-openssl-rand
POSTGRES_DB=ragdocs

# Local LLM. llama3.2:1b fits in ~1.3 GB RAM, llama3.2:3b needs ~2.5 GB.
OLLAMA_MODEL=llama3.2:1b

# Optional cross-encoder rerank. Adds ~200 MB RAM but improves citation
# accuracy by ~8 pp and reduces end-to-end latency.
RERANK_ENABLED=false

# Basic auth for write endpoints. One line, "username bcrypt-hash":
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
# Then set:
#   INGEST_BASIC_AUTH="admin $2a$14$abc...xyz"
INGEST_BASIC_AUTH="admin replace-with-bcrypt-hash"
