# --- Database ---
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/ragdocs

# --- Embeddings ---
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384
EMBED_BATCH_SIZE=32

# --- LLM (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
LLM_TIMEOUT_S=60

# --- Retrieval ---
RETRIEVE_TOP_K=5
RETRIEVE_SCORE_THRESHOLD=0.25
RERANK_ENABLED=false

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=100
